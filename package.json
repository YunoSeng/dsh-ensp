{
  "name": "dsh-ensp",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "让 AI 更好地使用华为 eNSP 做网络实验的 DSH 插件：批量 GUI 驱动 + telnet 下发 + .topo 读写 + 实验报告生成",
  "license": "MIT",
  "author": "YunoSeng",
  "homepage": "https://github.com/YunoSeng/dsh-ensp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunoSeng/dsh-ensp.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ensp",
    "huawei",
    "network-lab",
    "automation"
  ],
  "exports": {
    ".": "./index.js",
    "./mcp": "./mcp/server.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "dsh-ensp-mcp": "./bin/dsh-ensp-mcp.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/mcp-smoke.mjs"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib/bridge.py",
    "lib/launch.py",
    "lib/make_docs.py",
    "lib/*.js",
    "mcp",
    "bin",
    "test",
    "skills",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
